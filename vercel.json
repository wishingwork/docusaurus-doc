{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mission-api-664674930671.us-central1.run.app/$1"
    },
    {
      "source": "/plan-b-api/(.*)",
      "destination": "https://plan-b-api-664674930671.asia-east1.run.app/$1"
    },
    {
      "source": "/image-storage/(.*)",
      "destination": "https://xjftfkimdvazeeocrwut.storage.supabase.co/storage/v1/object/public/poster-images/$1"
    },
    {
      "source": "/ai-resource-calculator/(.*)",
      "destination": "https://ai-server-resource-calculator.vercel.app/$1"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "weathergo-admin-dashboard.vercel.app"
        }
      ],
      "destination": "https://weathergo.meteosync.com/$1",
      "permanent": true
    }
  ]
}